{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worldpop_download caller parameters",
  "$comment": "Parameter-only snapshot of catalog/tools/worldpop_download.yaml input_schema before automatic output allocation. The manifest is authoritative; path and permission checks require run-tool.",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Value supplied for this task.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "iso3": {
      "type": "string",
      "description": "Value supplied for this task.",
      "pattern": "^[A-Za-z]{3}$"
    },
    "year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "contains": {
      "type": "string",
      "description": "Value supplied for this task."
    },
    "extensions": {
      "type": "string",
      "description": "Value supplied for this task."
    },
    "root": {
      "type": "string",
      "description": "Must be under the authorized data workspace."
    },
    "download": {
      "type": "boolean"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "project"
  ],
  "additionalProperties": false
}
